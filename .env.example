# AI Trading Assistant — Environment Configuration

# Trading Mode: Must remain PAPER in Version 1. Real trading disabled by default.
TRADING_MODE=PAPER

# Capital & Risk Controls
INITIAL_CAPITAL=10000.0
MAX_INVESTMENT_PER_TRADE=5000.0
RISK_PER_TRADE=0.015
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3
MIN_RISK_REWARD=0.8
MIN_AI_CONFIDENCE=0.75
DEFAULT_TIMEFRAME=5m

# Database Configuration (SQLite for local v1, easily migrated to PostgreSQL)
DATABASE_URL=sqlite:///./database/trading.db

# AI Provider Configuration
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Future Zerodha Integration (Leave blank for Version 1)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
